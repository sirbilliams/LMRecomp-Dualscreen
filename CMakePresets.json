{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-clang",
      "displayName": "Windows (clang-cl, Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux x86_64 (clang + lld, Ninja; docs/LINUX.md)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (NDK, Ninja; docs/ANDROID.md)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_HOME}/ndk/$env{ANDROID_NDK_VERSION}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared",
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": false
        },
        "CMAKE_DISABLE_FIND_PACKAGE_PkgConfig": {
          "type": "BOOL",
          "value": true
        },
        "CMAKE_DISABLE_FIND_PACKAGE_zstd": {
          "type": "BOOL",
          "value": true
        },
        "Rust_CARGO_TARGET": "aarch64-linux-android"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang",
      "configurePreset": "windows-clang"
    },
    {
      "name": "linux-clang",
      "configurePreset": "linux-clang"
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "targets": [
        "LuigisMansionRecomp"
      ]
    }
  ]
}
